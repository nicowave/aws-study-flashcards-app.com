# Stripe price IDs (not secret) — copy to functions/.env before deploying.
# Per-cert prices must be ONE-TIME prices; all-access must be a YEARLY
# recurring price. Checkout mode is derived from the price type.
STRIPE_PRICE_CLOUD_PRACTITIONER=price_xxx
STRIPE_PRICE_AI_PRACTITIONER=price_xxx
STRIPE_PRICE_SOLUTIONS_ARCHITECT=price_xxx
STRIPE_PRICE_ALL_ACCESS=price_xxx
# Secrets are set separately:
#   firebase functions:secrets:set STRIPE_API_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
